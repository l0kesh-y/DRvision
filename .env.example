# ──────────────────────────────────────────────
#  DRVision – Environment Configuration Template
#  Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# ── Google Gemini AI (FREE) ─────────────────────
# Get your free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Gemini vision model to use (free tier)
GEMINI_MODEL=gemini-1.5-flash

# ── Neon PostgreSQL ─────────────────────────────
# Get yours free at https://neon.tech → New Project → Connection Details
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Flask ───────────────────────────────────────
SECRET_KEY=drvision-secret-change-me-in-production
FLASK_DEBUG=false

# ── Filesystem paths ────────────────────────────
UPLOAD_FOLDER=uploads
HEATMAP_FOLDER=heatmaps
DATASET_FOLDER=dataset
TRAIN_IMAGES_FOLDER=dataset/train_images
